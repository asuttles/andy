program float

const float PI = 3.141592;

float lnx, y;

fun times2(int x, float z) :float

  float result;
  
  begin
     result := 2.0;
     
     if x > 2 then
        result := 2.0;
     
     result := result * z;

     return result;
   end

begin
   lnx := ln(5.0);
   y   := 3.0;
   write "The result is: ";
   writeNL;
   write lnx;
   return exp(y*lnx);
end.     