// Test Recursive Function Calling
program int

int x;

// Fibonacci Function
fun fib(int n) : int
   begin
      if n = 1 or n = 2 then
         return 1;
      else
         return fib(n-2) + fib(n-1);
   end

// Main Function
begin
   x := 10;
   write fib(x);
   writeNL;
end.
